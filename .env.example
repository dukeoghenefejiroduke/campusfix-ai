# CampusFix AI — Environment Variables Template
# Copy this file to .env and configure when connecting an external open-weight model API.
# Leave blank to use the built-in offline rules engine and TF-IDF semantic memory.

# Server Port (optional, defaults to 3000)
PORT=3000

# Open-Weight Model API Configuration (OpenAI-compatible endpoints e.g. Groq, Ollama, Hugging Face)
OPEN_WEIGHT_API_URL=https://api.groq.com/openai/v1/chat/completions
OPEN_WEIGHT_API_KEY=YOUR_EXISTING_KEY
OPEN_WEIGHT_MODEL_NAME=openai/gpt-oss-20b